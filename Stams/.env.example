# ─── Camera Sources ───────────────────────────────────────────────
# Comma-separated list of camera sources (1 to N cameras).
# Use integer for USB webcam (e.g. 0, 1)
# Use URL for RTSP IP cameras or Android IP Webcam app
# Examples:
#   Single USB:       CAMERA_SOURCES=0
#   Two Android:      CAMERA_SOURCES=http://192.168.1.101:8080/video,http://192.168.1.102:8080/video
#   Mixed:            CAMERA_SOURCES=0,http://192.168.1.101:8080/video,rtsp://admin:pass@192.168.1.200:554/stream
CAMERA_SOURCES=0

# Maximum number of cameras the system will accept
MAX_CAMERAS=16

# ─── Detection ────────────────────────────────────────────────────
DETECTION_CONF=0.4

# ─── Face Matching ────────────────────────────────────────────────
MATCH_THRESHOLD=0.6

# ─── Pose & Movement ─────────────────────────────────────────────
PANIC_VELOCITY_THRESHOLD=15.0

# ─── Crowd Behaviour ─────────────────────────────────────────────
AGITATED_RATIO=0.4

# ─── Alerts ───────────────────────────────────────────────────────
ALERT_COOLDOWN_SEC=10

# ─── GPU ──────────────────────────────────────────────────────────
GPU_DEVICE=0
USE_FP16=true

# ─── API Server ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=storage/logs

# ─── Frame Dimensions (YOLO input) ───────────────────────────────
FRAME_WIDTH=640
FRAME_HEIGHT=640

# ─── ByteTrack ────────────────────────────────────────────────────
TRACK_THRESH=0.5
TRACK_BUFFER=30
MATCH_THRESH=0.8
