# ─── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl
.eggs/
venv/
.venv/
env/

# ─── Environment ──────────────────────────────────────────────────
.env

# ─── Models (large binaries) ─────────────────────────────────────
models/*.pt
models/*.engine
models/*.onnx
models/arcface/

# ─── Storage (runtime data) ──────────────────────────────────────
storage/embeddings/*.npy
storage/snapshots/
