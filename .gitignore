# ─── Targets ──────────────────────────────────────────────────────
targets/*.jpg
targets/*.png
targets/*.jpeg

# ─── Node / Frontend ─────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.next/

# ─── IDE / OS ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ─── Docker ───────────────────────────────────────────────────────
.dockerignore

